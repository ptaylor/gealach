# Node (declared no dependencies today; present if one ever lands)
node_modules/
# Empty lockfile while there are no dependencies; commit it if one is added.
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local state and secrets (unused today; required the moment a keyed source lands)
.env
*.env
.env.local
*.log
# The GoatCounter report reads GOATCOUNTER_API_TOKEN from here (a secret).
.env.sh

# Python (development only) — the report tool. Its venv and bytecode are local;
# report/README.md and report/goatcounter-report.py are source and committed.
__pycache__/
*.py[cod]
report/.venv/
.python-version

# Generated report output — regenerated on demand, not committed.
reports/

# Editor and OS metadata
.DS_Store
*.swp

# VS Code: ignore specific local artefacts only, never the folder wholesale
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# NOTE: data/stations.json and data/station-map.json are vendored SOURCE and
# must be committed — do not add a blanket `data/` or `*.json` ignore.
